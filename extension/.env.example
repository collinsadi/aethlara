# API base URL, including the /api/v1 prefix. Its origin is added to the
# manifest's host_permissions at build time (e.g. http://localhost:18080/api/v1
# for a local server).
VITE_API_BASE_URL=https://aethlara-api.collinsadi.xyz/api/v1

# Dashboard origin. "Connect" opens <dashboard>/settings#extension, and only
# handshake pages on this origin (or localhost) are accepted.
VITE_DASHBOARD_URL=https://aethlara.collinsadi.xyz

# Query parameter that carries the one-time handshake token.
VITE_EXTENSION_TOKEN_PARAM=ext_token
