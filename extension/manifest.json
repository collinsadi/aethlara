{
  "manifest_version": 3,
  "name": "Aethlara",
  "version": "2.0.0",
  "description": "Your job-search autopilot: fills and submits the applications you approve, in your own browser.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "activeTab",
    "sidePanel",
    "notifications"
  ],
  "host_permissions": [
    "https://aethlara-api.collinsadi.xyz/*",
    "http://localhost:8081/*"
  ],
  "background": {
    "service_worker": "background/index.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "action": {
    "default_title": "Open Aethlara",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"
  },
  "web_accessible_resources": []
}
